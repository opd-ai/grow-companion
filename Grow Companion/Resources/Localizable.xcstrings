    "Offline lessons and practical checklists" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Lecciones sin conexión y listas prácticas" } } } },
    "On-device store protected with complete file protection." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Almacén en el dispositivo protegido con protección completa de archivos." } } } },
    "Only readings from a paired sensor can be marked sensor-sourced." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Solo las lecturas de un sensor vinculado pueden marcarse como de sensor." } } } },
    "Only when you choose it" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Solo cuando lo eliges" } } } },
