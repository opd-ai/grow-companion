    "Yield" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Rendimiento" } } } },
    "Yield, timing and your rating side by side" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Rendimiento, tiempos y tu valoración en paralelo" } } } },
    "Your jurisdiction does not permit home cultivation. This plant will not be added to a tracked grow." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Tu jurisdicción no permite cultivar en casa. Esta planta no se añadirá a un cultivo registrado." } } } },
    "Your strain library is empty. Add one, or create this plant now and assign a strain later." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Tu biblioteca de variedades está vacía. Añade una, o crea esta planta ahora y asigna la variedad después." } } } },
    "days" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "días" } } } },
    "A plant gets a window the moment it moves into flower." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Una planta obtiene una ventana en cuanto pasa a floración." } } } },
    "All photos" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Todas las fotos" } } } },
    "All plants" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Todas las plantas" } } } },
    "All types" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Todos los tipos" } } } },
    "Below 55% dries too fast — slow it down by lowering airflow." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Por debajo del 55% se seca demasiado rápido: bájalo reduciendo la circulación de aire." } } } },
