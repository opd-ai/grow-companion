    "Photos are included only when you choose them. No location data is written into the archive." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Las fotos se incluyen solo cuando las eliges. No se escriben datos de ubicación en el archivo." } } } },
