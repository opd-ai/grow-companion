    "Backup and restore" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Copia de seguridad y restauración" } } } },
    "Bluetooth is unavailable. Turn it on or use Wi-Fi pairing instead." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Bluetooth no está disponible. Actívalo o usa la vinculación por Wi-Fi." } } } },
    "Care digest" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Resumen de cuidados" } } } },
    "Change jurisdiction" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Cambiar jurisdicción" } } } },
    "Choose backup from Files" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Elegir copia de Archivos" } } } },
    "Choose rooms in Notifications → Daily care digest to preview their care activity and unfinished tasks." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Elige salas en Notificaciones → Resumen diario de cuidados para previsualizar su actividad y sus tareas pendientes." } } } },
    "Choose scope, categories and expiry" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Elige alcance, categorías y caducidad" } } } },
