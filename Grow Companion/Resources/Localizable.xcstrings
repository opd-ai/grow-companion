    "Photoperiod is everything now. Keep the dark period completely dark, watch humidity, and check trichomes as the weeks go by." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "El fotoperiodo lo es todo ahora. Mantén el periodo oscuro completamente a oscuras, vigila la humedad y revisa los tricomas con las semanas." } } } },
    "Plain-language guidance and gentle prompts" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Guía en lenguaje sencillo y avisos amables" } } } },
    "Progressive" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Progresivo" } } } },
