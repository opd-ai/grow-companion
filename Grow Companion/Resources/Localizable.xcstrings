{
  "sourceLanguage" : "en",
  "strings" : {
    "A cross of both, with the ratio left to the breeder" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Un cruce de ambas, con la proporción a criterio del criador" } } } },
    "A few cycles" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Algunos ciclos" } } } },
    "A house you control, including the yard" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Una casa que controlas, incluido el patio" } } } },
    "Apartment, condo or shared building" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Departamento, condominio o edificio compartido" } } } },
    "Bend and tie branches to level the canopy." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Dobla y ata las ramas para nivelar el dosel." } } } },
    "Bluetooth" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Bluetooth" } } } },
    "Burp the jars, keep humidity near 58–62%, and let the flower cure for two to four weeks before you judge it." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Airea los frascos, mantén la humedad cerca de 58–62% y deja curar la flor de dos a cuatro semanas antes de juzgarla." } } } },
    "Cancel" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Cancelar" } } } },
    "Close" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Cerrar" } } } },
