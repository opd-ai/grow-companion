    "Closet" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Armario" } } } },
    "Compact and broad-leafed, usually a shorter flowering window" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Compacta y de hoja ancha, normalmente con floración más corta" } } } },
    "Compact interface, raw numbers, fewer prompts" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Interfaz compacta, números directos, menos avisos" } } } },
    "Consumed at home" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Consumida en casa" } } } },
