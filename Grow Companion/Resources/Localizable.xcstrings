    "Compare cycles" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Comparar ciclos" } } } },
    "Cure begins when stems snap cleanly" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "El curado empieza cuando los tallos se rompen limpiamente" } } } },
