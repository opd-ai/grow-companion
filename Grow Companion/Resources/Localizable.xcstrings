    "Reminders that land inside the window move to its end." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Los recordatorios que caen dentro del horario pasan a su final." } } } },
    "Remove" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Quitar" } } } },
