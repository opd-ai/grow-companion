    "Cycle archive" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Archivo de ciclos" } } } },
    "Every action you take here — deleting a plant, moving a plant on, changing a canopy — updates this count immediately." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Cada acción que haces aquí —eliminar una planta, avanzar una planta, cambiar un dosel— actualiza este recuento al instante." } } } },
