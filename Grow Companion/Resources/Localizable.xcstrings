    "Lock-screen content" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Contenido en la pantalla bloqueada" } } } },
    "Manual entry stays available" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "La entrada manual sigue disponible" } } } },
    "Nearby Bluetooth sensors" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Sensores Bluetooth cercanos" } } } },
