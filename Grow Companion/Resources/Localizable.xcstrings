    "Open a shared grow" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Abrir un cultivo compartido" } } } },
    "Pair a sensor" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Vincular un sensor" } } } },
    "Pair a supported Bluetooth or Wi-Fi environmental sensor, then assign it to the room it serves." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Vincula un sensor ambiental compatible por Bluetooth o Wi-Fi y asígnalo a la sala a la que sirve." } } } },
