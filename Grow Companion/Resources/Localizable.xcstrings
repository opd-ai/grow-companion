    "Enter a wet weight to start the log." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Introduce un peso húmedo para empezar el registro." } } } },
    "Every record is still here. Clear a filter to see the rest of the garden." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Todos los registros siguen aquí. Quita un filtro para ver el resto del cultivo." } } } },
    "Everything in one place" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Todo en un solo lugar" } } } },
    "Feed volume counts the feed logged for each plant's room during its flower window." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "El volumen de riego cuenta lo registrado en la sala de cada planta durante su ventana de floración." } } } },
    "Finish curing" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Terminar curado" } } } },
