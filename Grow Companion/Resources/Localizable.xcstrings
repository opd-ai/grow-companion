    "Revoke access" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Revocar acceso" } } } },
    "Revoking records the change here. A file that was already handed over cannot be recalled." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Revocar registra el cambio aquí. Un archivo que ya se entregó no se puede recuperar." } } } },
    "Room sensors" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Sensores de la sala" } } } },
    "Rooms in this digest" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Salas en este resumen" } } } },
    "Secure your backup with a password" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Protege tu copia con una contraseña" } } } },
    "Selected rooms" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Salas seleccionadas" } } } },
    "Send a daily digest" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Enviar un resumen diario" } } } },
    "Send it to the person you share with" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Envíalo a la persona con la que compartes" } } } },
