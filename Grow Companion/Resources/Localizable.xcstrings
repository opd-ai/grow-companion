    "Remove leaves to open airflow and light." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Retira hojas para abrir la ventilación y la luz." } } } },
    "Remove the growing tip to split the canopy." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Retira el brote apical para dividir el dosel." } } } },
