    "General CMH manufacturer guidance; verify your fixture manual" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Guía general del fabricante para CMH; verifica el manual de tu luminaria" } } } },
    "General HPS manufacturer guidance; verify your fixture manual" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Guía general del fabricante para HPS; verifica el manual de tu luminaria" } } } },
    "General LED manufacturer guidance; verify your fixture manual" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Guía general del fabricante para LED; verifica el manual de tu luminaria" } } } },
    "General fluorescent fixture guidance; verify your fixture manual" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Guía general para luminarias fluorescentes; verifica el manual de tu luminaria" } } } },
