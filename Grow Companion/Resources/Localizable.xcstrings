    "We use this only to load your plant limits. Grow Companion does not send it anywhere." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Solo lo usamos para cargar tus límites de plantas. Grow Companion no lo envía a ningún sitio." } } } },
