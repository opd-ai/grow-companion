    "Cutting" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Esqueje sin enraizar" } } } },
    "Daily in week one, then every 2–3 days" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Diario en la primera semana, luego cada 2–3 días" } } } },
