    "Latest checks" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Últimos controles" } } } },
    "Leave it blank if you are still weighing; the plant moves to storage either way." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Déjalo en blanco si aún estás pesando; la planta pasa a almacenaje igualmente." } } } },
    "Log burp" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Registrar aireado" } } } },
    "Log the first check to start the record." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Registra el primer control para empezar el registro." } } } },
    "Log today's check" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Registrar el control de hoy" } } } },
    "Mark another plant as harvested — or finish another cycle of this strain — and its numbers sit beside this one." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Marca otra planta como cosechada —o termina otro ciclo de esta variedad— y sus números aparecerán junto a los de este." } } } },
    "Next up" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "A continuación" } } } },
